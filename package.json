{
  "name": "@we-made/pointer-assets-client",
  "version": "0.1.0",
  "description": "Browser SDK for Pointer asset uploads and CDN-protected downloads",
  "license": "MIT",
  "author": "We Made AS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wemadefree/pointer-assets-client.git"
  },
  "bugs": {
    "url": "https://github.com/wemadefree/pointer-assets-client/issues"
  },
  "homepage": "https://github.com/wemadefree/pointer-assets-client#readme",
  "keywords": [
    "pointer",
    "assets",
    "cloud-cdn",
    "gcs",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.2.3",
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run typecheck && npm test",
    "package:check": "node scripts/verify-package.mjs",
    "release:check": "node scripts/validate-release-tag.mjs",
    "prepack": "npm run clean && npm run validate && npm run build && npm run package:check"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
