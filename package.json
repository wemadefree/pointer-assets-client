{
  "name": "@we-made/pointer-assets-client",
  "version": "0.1.0",
  "description": "Browser SDK for Pointer asset uploads and CDN-protected downloads",
  "license": "MIT",
  "author": "We Made AS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wemadefree/pointer-assets-client.git"
  },
  "bugs": {
    "url": "https://github.com/wemadefree/pointer-assets-client/issues"
  },
  "homepage": "https://github.com/wemadefree/pointer-assets-client#readme",
  "keywords": [
    "pointer",
    "assets",
    "cloud-cdn",
    "gcs",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
